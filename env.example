# Berkeley Personal Calendar Server - Environment Variables Template

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Server Configuration
PORT=3001

# Google Sheets Sync Configuration
# Generate a secure random token for Google Sheets API authentication
SYNC_SECRET_TOKEN=your-secure-random-token-here

# Instructions:
# 1. Copy this file to .env: cp env.example .env
# 2. Replace the placeholder values with your actual credentials
# 3. Generate a secure token for SYNC_SECRET_TOKEN (e.g., use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# 4. Never commit your .env file to version control



