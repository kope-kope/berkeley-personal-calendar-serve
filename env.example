# Berkeley Personal Calendar Server - Environment Variables Template

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Server Configuration
PORT=3001

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Google Sheets Sync Configuration
# Generate a secure random token for Google Sheets API authentication
SYNC_SECRET_TOKEN=your-secure-random-token-here

# Google OAuth2 Configuration (for Calendar API)
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Gmail API Configuration (for sending emails)
# Sender email address
GMAIL_SENDER_EMAIL=tosin.oladokun@berkeley.edu
# Refresh token for sender account (obtain via OAuth flow with scope: https://www.googleapis.com/auth/gmail.send)
GMAIL_SENDER_REFRESH_TOKEN=your_sender_refresh_token_here

# Instructions:
# 1. Copy this file to .env: cp env.example .env
# 2. Replace the placeholder values with your actual credentials
# 3. Generate a secure token for SYNC_SECRET_TOKEN (e.g., use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# 4. For Google OAuth:
#    - Go to Google Cloud Console > APIs & Services > Credentials
#    - Create OAuth 2.0 Client ID (Web application)
#    - Add authorized redirect URI: http://localhost:3001/api/auth/google/callback
#    - Enable Google Calendar API in APIs & Services > Library
# 5. Never commit your .env file to version control